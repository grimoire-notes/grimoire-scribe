#!/bin/sh
# Stands in for curl in a Package Store scenario with a network (tests/scenarios/z_package_store_first_visit.qs,
# whose PATH has this folder first). "curl -q -fsSL https://store.test/PATH", the one form Grimoire runs, answers
# from the files of package-store-served in the scenario's data root (tests/store_many_packages.py makes them
# there) after a short wait, as a download takes one: index.json is the catalog, any other path a file of assets/.
# Nothing leaves the machine. Another form, another host, a path with ".." or a file that is not there fails with
# curl's status for a failed request, 22.
url="${3:-}"
rel="${url#https://store.test/}"
[ "${1:-}" = -q ] && [ "${2:-}" = -fsSL ] && [ "$rel" != "$url" ] && [ -n "${GRIMOIRE_ROOT:-}" ] || exit 22
case "$rel" in *..*) exit 22 ;; esac
served="$GRIMOIRE_ROOT/package-store-served"
sleep 0.3
if [ "$rel" = index.json ]; then f="$served/index.json"; else f="$served/assets/$rel"; fi
[ -f "$f" ] || exit 22
exec cat "$f"
